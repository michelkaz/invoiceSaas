# ─────────────────────────────────────────────────────────────
# Supabase — Project Settings → API
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<clé publishable / anon>

# ─────────────────────────────────────────────────────────────
# Emails transactionnels (envoi de factures par email) — Resend
# Optionnel : sans ces variables, le bouton « Envoyer » affiche
# un message invitant à configurer l'envoi.
# https://resend.com → API Keys
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Expéditeur vérifié dans Resend (ou onboarding@resend.dev en bac à sable)
EMAIL_FROM="Facturi <onboarding@resend.dev>"
